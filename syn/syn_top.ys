read_verilog -sv src/top.sv
read_verilog -sv src/part_01.sv
read_verilog -sv src/part_02.sv
read_verilog -sv src/solution2char.sv
read_verilog -sv src/lib/uart/uart_rx.sv
read_verilog -sv src/lib/uart/uart_tx.sv
read_verilog -sv src/lib/mem/mem_arty_4kb_wrapper.sv
read_verilog -sv src/lib/mem/mem_arty_205kb.sv
read_verilog -sv src/lib/bin2bcd/bin2bcd.sv

# Set top module
hierarchy -top top

# Basic fast synthesis
proc
opt
fsm
opt
memory_collect
opt
techmap
opt

# write synthesized netlist
write_verilog syn/synth.v

# Overall usage report
tee -o syn/top.rpt stat

# # Make part_01 the top
select -module part_01
flatten
tee -o syn/part_01.rpt stat -hierarchy

# # Make part_02 the top
select -module part_02
flatten
tee -o syn/part_02.rpt stat -hierarchy